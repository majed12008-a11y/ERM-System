# ─── Server ───
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Number of proxy hops to trust (1 = nginx, 2 = nginx + CDN)
TRUST_PROXY=1

# ─── Database ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ethics_db
DB_USER=ethics_app
# Required in production. Change to your secure DB password.
DB_PASSWORD=change-this-to-your-db-password
# Enable SSL for database connections (set to true for cloud/managed DB)
DB_SSL=false
# Reject unauthorized SSL certs (set to false for self-signed certs)
DB_SSL_REJECT_UNAUTHORIZED=true
# Statement timeout in milliseconds (0 = no timeout)
DB_STATEMENT_TIMEOUT=30000
# Idle transaction timeout in milliseconds
DB_IDLE_TX_TIMEOUT=60000

# ─── Rate Limiting ───
# Global rate limit (requests per minute, applies to all API routes)
RATE_LIMIT_GLOBAL_MAX=60
# Auth rate limit window in milliseconds
RATE_LIMIT_AUTH_WINDOW_MS=60000
# Per-endpoint auth rate limits (requests per window)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_MAX=3
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_RESET_PASSWORD_MAX=5
RATE_LIMIT_RESEND_VERIFICATION_MAX=5
RATE_LIMIT_VERIFY_MAX=10

# ─── Authentication ───
# Required. Minimum 32 chars for HS256.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-64-char-string

# ─── CORS (production only, comma-separated) ───
CORS_ORIGIN=http://localhost:5173

# ─── Data Encryption (for national_id, passport_number, etc.) ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required. Minimum 64 hex chars for AES-256.
DB_ENCRYPTION_KEY=change-this-to-a-random-64-hex-char-string

# ─── Migration (node-pg-migrate CLI only) ───
DATABASE_URL=postgres://ethics_migration:MIGRATION_PASSWORD@localhost:5432/ethics_db
